# Copy to .env and edit before first launch.

# Unraid path. For local non-Unraid testing, use ./local-appdata
APPDATA_ROOT=/mnt/cache/appdata/icarus
STEAMCMD_ROOT=/mnt/user/appdata/steamcmd

# Network
# Host/container ports must be symmetric because Icarus advertises these values
# to Steam. These are what UniFi forwards to the Unraid host.
GAME_PORT=20008
QUERY_PORT=20009

# Server identity
SERVER_NAME="SlurpNet Icarus"
SERVER_PASSWORD=
ADMIN_PASSWORD=
MAX_PLAYERS=8

# SteamCMD / container
GAME_ID=2089300
VALIDATE=
UID=99
GID=100

# Deploy behavior
ICARUS_RECONCILE_CONTAINER=0
